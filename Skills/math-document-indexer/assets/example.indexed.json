            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "4"
          },
          "identifier": "Corollary 1"
        },
        "content": {
          "type": "corollary",
          "body": "Every finite sum of even integers is even.",
          "proof": "Apply Theorem 1 inductively to the summands. The empty sum is $0=2\\cdot 0$."
        },
        "relations": [
          {
            "type": "depends_on",
            "target": 4,
            "basis": "explicit",
            "explanation": "The proof invokes Theorem 1."
          }
        ]
      }
