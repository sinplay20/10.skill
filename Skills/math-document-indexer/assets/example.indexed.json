            ],
            "page": "1"
          },
          "identifier": "Definition 1"
        },
        "content": {
          "type": "definition",
          "body": "An integer $n$ is even if there exists $k\\in\\mathbb{Z}$ such that $n=2k$.",
          "proof": ""
        },
        "relations": []
      }
    },
    {
      "index": 3,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "1"
          },
          "identifier": "Definition 2"
        },
        "content": {
          "type": "definition",
          "body": "An integer $n$ is odd if there exists $k\\in\\mathbb{Z}$ such that $n=2k+1$.",
          "proof": ""
        },
        "relations": []
      }
    },
    {
      "index": 4,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "2"
          },
          "identifier": "Theorem 1"
        },
        "content": {
          "type": "theorem",
          "body": "If $a$ and $b$ are even, then $a+b$ is even.",
          "proof": "By Definition 1, there exist $m,n\\in\\mathbb{Z}$ with $a=2m$ and $b=2n$.\n\nThus $a+b=2(m+n)$. Since $m+n\\in\\mathbb{Z}$, Definition 1 gives the conclusion."
        },
        "relations": [
          {
            "type": "depends_on",
            "target": 2,
            "basis": "explicit",
            "explanation": "The proof invokes Definition 1."
          },
          {
            "type": "equivalent_to",
            "target": 5,
            "basis": "inferred",
            "explanation": "Closure under addition restates the theorem; the text does not assert the equivalence explicitly."
          }
        ]
      }
    },
    {
      "index": 5,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "2"
          },
          "identifier": ""
        },
        "content": {
          "type": "statement",
          "body": "Thus the set of even integers is closed under addition.",
          "proof": ""
        },
        "relations": []
      }
    },
    {
      "index": 6,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "2"
          },
          "identifier": "Lemma 1"
        },
        "content": {
          "type": "lemma",
          "body": "If $a$ is even, then $-a$ is even.",
          "proof": "By Definition 1, write $a=2m$. Then $-a=2(-m)$ and $-m\\in\\mathbb{Z}$."
        },
        "relations": [
          {
            "type": "depends_on",
            "target": 2,
            "basis": "explicit",
            "explanation": "The proof invokes Definition 1."
          }
        ]
      }
    },
    {
      "index": 7,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "3"
          },
          "identifier": "Proposition 1"
        },
        "content": {
          "type": "proposition",
          "body": "If $a$ is even and $b\\in\\mathbb{Z}$, then $ab$ is even.",
          "proof": "By Definition 1, $a=2m$ for some integer $m$. Hence $ab=2(mb)$, so the product is even."
        },
        "relations": [
          {
            "type": "depends_on",
            "target": 2,
            "basis": "explicit",
            "explanation": "The proof invokes Definition 1."
          }
        ]
      }
    },
    {
      "index": 8,
      "Original": {
        "indexing": {
          "location": {
            "document": "sources/files/even-integers-demo.tex",
            "section": [
              "Even integers and parity"
            ],
            "page": "3"
          },
          "identifier": "Theorem 2"
        },
        "content": {
          "type": "theorem",
          "body": "The sum of two odd integers is even.",
          "proof": "By Definition 2, write $a=2m+1$ and $b=2n+1$. Then $a+b=2(m+n+1)$, which is even by Definition 1."
        },
        "relations": [
          {
            "type": "depends_on",
            "target": 2,
            "basis": "explicit",
            "explanation": "The proof invokes Definition 1."
          },
          {
            "type": "depends_on",
            "target": 3,
            "basis": "explicit",
            "explanation": "The proof invokes Definition 2."
          }
        ]
      }
    },
    {
      "index": 9,
